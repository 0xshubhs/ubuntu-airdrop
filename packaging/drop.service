[Unit]
Description=Drop - LAN file transfer
Documentation=https://github.com/0xshubhs/ubuntu-airdrop
After=network-online.target avahi-daemon.service
Wants=network-online.target

# Enabled globally, so the greeter (gdm, uid 975) gets a user manager that
# tries to run this too. It then fights the real session for the port and
# restart-loops until systemd gives up. Only humans receive files.
ConditionUser=!@system

[Service]
Type=simple
ExecStart=/usr/bin/drop serve
Restart=on-failure
RestartSec=3

# This is a --user unit, so it cannot manipulate the capability bounding set.
# PrivateDevices / ProtectKernelTunables / ProtectControlGroups all imply that
# and fail with 218/CAPABILITIES before the binary ever runs. NoNewPrivileges
# is the one that works unprivileged.
NoNewPrivileges=true

[Install]
WantedBy=default.target
